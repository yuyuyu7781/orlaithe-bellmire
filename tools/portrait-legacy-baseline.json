    "name": "ガレン",
    "role": "運河・水門の門番",
    "lines": {
      "human": {
        "default": [
          "水位標を見ろ。舟を入れる時は、下の門からだ。",
          "この下の石組みは、俺たちが造ったものじゃない。使えるから使う。"
        ]
      },
      "cat": {
        "default": [
          "その隙間なら通れるんだね。濡れた石には気をつけて。"
        ]
      }
    },
    "src": "./assets/portraits/cv-garen-default.png",
