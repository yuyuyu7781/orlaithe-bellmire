        "journal": [
          {
            "id": "drowned:entry",
            "day": 4,
            "text": "水が引いた湖岸に、古い石道が現れていた。",
            "kind": "place",
            "playerMode": "human"
          },
          {
            "id": "drowned:post",
            "day": 4,
            "text": "水に触れていたところだけ、木が黒い。縄の跡は、もうほどけている。",
            "kind": "place",
            "playerMode": "human"
          },
          {
            "id": "drowned:walk",
            "day": 4,
            "text": "濡れた石道を歩いた。岸の声が、少し遠くなった。",
            "kind": "place",
            "playerMode": "human"
          },
          {
            "id": "drowned:mark",
            "day": 4,
            "text": "欠けた円のそばに、斜めの短い線。向きだけが、どこか違う。",
            "kind": "place",
            "playerMode": "human"
          },
          {
            "id": "drowned:hollow",
            "day": 4,
            "text": "丸い窪みの内側だけ、石の色が濃い。端が一か所、欠けている。",
            "kind": "place",
            "playerMode": "human"
          },
          {
            "id": "drowned:end",
            "day": 4,
            "text": "石道はここで崩れている。水の下にも、細い列が続いているように見える。",
            "kind": "place",
            "playerMode": "human"
          },
          {
            "id": "drowned:cat-circle",
            "day": 4,
            "text": "草の根の下に、小さな丸い石片。縁だけがすり減っている。",
            "kind": "cat",
            "playerMode": "cat"
          },
          {
            "id": "drowned:cat-lines",
            "day": 4,
            "text": "石の下面に、浅い線。水の匂いの向こうに、古い革の匂いが残っている。",
            "kind": "cat",
            "playerMode": "cat"
          }
        ]
      }
    },
