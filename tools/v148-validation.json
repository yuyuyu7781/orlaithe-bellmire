  "eventOperations": [
    {
      "id": "delayed-grain",
      "profile": "human",
      "text": "届いていない小麦袋\n\n荷札には袋が三つとある。並んでいるのは二つで、残りの場所だけきれいに空いている。\n\n閉じる"
    },
    {
      "id": "missing-folio",
      "profile": "human",
      "text": "空いた本の包み\n\n紐だけが丸く残っている。誰かが本を読み終えたら、ここへ戻すつもりだったのだろう。\n\n閉じる"
    },
    {
      "id": "cat-bread",
      "profile": "cat",
      "text": "袋の裏の匂い\n\n粉の匂いの奥に、冷めたパンの甘い匂いがある。小さな欠片が、袋の陰に転がっている。\n\n閉じる"
    },
    {
      "id": "cat-ribbon",
      "profile": "cat",
      "text": "荷物の陰の紐\n\n箱の陰で、短い紐が風に動いている。人の手より、濡れた木の匂いが強い。\n\n閉じる"
    }
